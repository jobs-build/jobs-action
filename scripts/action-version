#!/usr/bin/env bash
# Prints the release that action.yml runs: its JOBS_ACTION_VERSION literal.
set -euo pipefail
cd "$(dirname "$0")/.."
version=$(sed -n 's/^ *JOBS_ACTION_VERSION: *\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) *$/\1/p' action.yml)
if [ "$(printf '%s\n' "$version" | grep -c .)" != 1 ]; then
  echo "action.yml must hold exactly one 'JOBS_ACTION_VERSION: vX.Y.Z' line" >&2
  exit 1
fi
echo "$version"
